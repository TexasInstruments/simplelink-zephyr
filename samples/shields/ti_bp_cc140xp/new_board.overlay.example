 * SPDX-License-Identifier: Apache-2.0
 *
 * Starting point for porting any ti_cc140xp_* sample to a new board.
 *
 * This is NOT picked up automatically by the build - copy it into the
 * sample's boards/ directory as <your_board_name>.overlay (matching
 * Zephyr's board-overlay naming convention), then adjust the SPI bus, pins,
 * and polarities for your actual wiring.
 *
 * Every existing ti_cc140xp_* sample overlay (see boards/
 * lp_em_cc2745r10_q1_cc2745r10_q1.overlay in any sample) follows this exact
 * same direct-wiring pattern - reference those for a real, hardware-verified
 * example.
 *
 * The full set of required/optional devicetree properties is defined by
 * the binding at dts/bindings/misc/ti,cc140xp-trx.yaml - check there if a
 * property below looks unfamiliar or you're unsure whether it's required.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/* Replace &spi1 with whichever SPI bus your transceiver is actually wired
 * to (e.g. &spi0), and make sure that bus's pinctrl is configured in your
 * board's own devicetree (SCLK/MOSI/MISO) - this overlay only adds the
 * transceiver device and its CS pin, it doesn't configure the bus itself.
 */
&spi1 {
	status = "okay";

	cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;

	ti_cc140xp: ti_cc140xp@0 {
		compatible = "ti,cc140xp-trx";
		reg = <0>;
		spi-max-frequency = <12000000>;

		/* Reset pin */
		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

		/* Interrupt pin */
		trx-host-spi-int-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;

		/* POCI (MISO) GPIO - polled after CS assert for the TRX ready
		 * handshake, in addition to the SPI controller's own MISO line. */
		poci-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
	};
};
