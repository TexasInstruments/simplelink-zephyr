config SPI_CC35XX
	bool "TI SimpleLink CC35xx SPI driver"
	default y
	depends on DT_HAS_TI_CC35XX_SPI_ENABLED
	select PINCTRL
	help
	  Enable support for the TI SimpleLink CC35xx SPI peripheral

if SPI_CC35XX

config SPI_CC35XX_DMA_DRIVEN
	bool "CC35XX SPI DMA support"
	default n
	select DMA
	help
	  Enables DMA for SPI transfers.

endif # SPI_CC35XX
