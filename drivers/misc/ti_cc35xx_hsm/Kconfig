config TI_CC35XX_HSM
	bool "TI SimpleLink CC35xx Hardware Security Module (HSM)"
	default n
	depends on DT_HAS_TI_CC35XX_HSM_ENABLED
	select RING_BUFFER
	help
	  This option enables the driver for the Hardware Security Module (HSM)
	  for TI SimpleLink CC35xx family SoCs.

if TI_CC35XX_HSM

config TI_CC35XX_HSM_INIT_PRIORITY
	int "TI CC35XX HSM driver init priority"
	depends on TI_CC35XX_HSM
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  TI CC35XX HSM driver device initialization priority.


config TI_CC35XX_HSM_ENTROPY_POOL_SIZE
	int "Number of bytes in the entropy pool"
	default 512
	range 256 65536
	help
	  The size in bytes of the buffer used to store entropy generated by the
	  hardware. Should be a power of two for high performance.

endif # TI_CC35XX_HSM
