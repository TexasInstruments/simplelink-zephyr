CONFIG_SHARED_MULTI_HEAP=y

CONFIG_GPIO=y
CONFIG_GPIO_GET_CONFIG=y
CONFIG_GPIO_GET_DIRECTION=y
CONFIG_GPIO_HOGS=y
CONFIG_GPIO_SHELL=y
CONFIG_GPIO_SHELL_INFO_CMD=y
CONFIG_GPIO_SHELL_TOGGLE_CMD=y
CONFIG_GPIO_SHELL_BLINK_CMD=y

CONFIG_SERIAL=y

CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SHELL=y
CONFIG_SHELL_STACK_SIZE=4096
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_API_INTERRUPT_DRIVEN=y

CONFIG_FLASH=y
CONFIG_SOC_FLASH_CC35XX=y
CONFIG_FLASH_SHELL=y

# There's a pin conflict between SPI, I2S and SD
# so only one can be enabled at a time.
CONFIG_SPI=y
CONFIG_SPI_CC35XX=y
CONFIG_SPI_SHELL=y

CONFIG_ENTROPY_CC35XX_RNG=y
CONFIG_ENTROPY_GENERATOR=y

CONFIG_RTC=y
CONFIG_RTC_TI_CC35XX=y
CONFIG_RTC_SHELL=y

CONFIG_ADC=y
CONFIG_ADC_CC35XX=y
CONFIG_ADC_SHELL=y

CONFIG_COUNTER=y
CONFIG_PWM=y
CONFIG_COUNTER_INIT_PRIORITY=32

CONFIG_WATCHDOG=y
CONFIG_WDT_SHELL=y

CONFIG_I2C=y
CONFIG_I2C_SHELL=y
CONFIG_I2C_CC35XX=y

CONFIG_SENSOR=y
CONFIG_SENSOR_SHELL=y
CONFIG_LM75=y
CONFIG_BMA4XX=y
# Required for BLE operation. Explicitly disable this config option here, as
# some BLE samples enable it by default.
CONFIG_BT_HCI_ACL_FLOW_CONTROL=n

CONFIG_DMA=y

# There's a pin conflict between SPI, I2S and SD
# so only one can be enabled at a time.
CONFIG_I2S=n
CONFIG_I2S_TI_CC35XX=n

# There's a pin conflict between SPI / I2S / CAN so they cannot
# be enabled at the same time.
CONFIG_CAN=n
CONFIG_CAN_TI_CC35XX=n
CONFIG_CAN_SHELL=n

# There's a pin conflict between SPI, I2S and SD
# so only one can be enabled at a time.
CONFIG_SDHC=n
CONFIG_SDHC_TI_CC35XX=n

CONFIG_EVENTS=y
