rsource "../lpf3_common/Kconfig.defconfig"

if BOARD_LP_EM_CC2755P10

if BT

config ZEPHYR
	bool
	default y

config BT_LL_HEAP_SIZE
	hex
	default 0x4E00

config BT_BUF_EVT_RX_SIZE
	default 255

config BT_BUF_ACL_RX_SIZE
	default 255

config BT_BUF_ACL_TX_SIZE
	default 251

config BT_BUF_CMD_TX_SIZE
	default 255

config BT_COMPANY_ID
	default 0x000D

choice BT_RECV_CONTEXT
	bool
	default BT_RECV_WORKQ_BT if BT_MESH
	default BT_RECV_WORKQ_SYS
endchoice

endif # BT

# The SPI driver only supports DMA mode
if SPI
config SPI_CC23X0_CC27XX_DMA_DRIVEN
	default y
endif # SPI

endif # BOARD_LP_EM_CC2755P10
