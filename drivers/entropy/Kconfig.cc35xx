# TI CC35xxE entropy driver configuration

# Copyright (c) 2025 Conclusive Engineering Sp. z o.o.
# SPDX-License-Identifier: Apache-2.0

config ENTROPY_CC35XX_RNG
	bool "TI SimpleLink CC35xxE Hardware Security Module (HSM)"
	default y
	depends on DT_HAS_TI_CC35XX_HSM_ENABLED
	select ENTROPY_HAS_DRIVER
	select RING_BUFFER
	help
	  This option enables the driver for the Hardware Security Module (HSM)
	  for TI SimpleLink CC35xxE SoCs.

if ENTROPY_CC35XX_RNG

config ENTROPY_CC35XX_POOL_SIZE
	int "Number of bytes in the entropy pool"
	default 512
	range 256 65536
	help
	  The size in bytes of the buffer used to store entropy generated by the
	  hardware. Should be a power of two for high performance.

endif # ENTROPY_CC35XX_RNG
