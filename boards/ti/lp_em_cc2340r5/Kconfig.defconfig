rsource "../lpf3_common/Kconfig.defconfig"

if BOARD_LP_EM_CC2340R5

if BT

config ZEPHYR
  bool
  default y

config BT_LL_HEAP_SIZE
    hex
    default 0x1880

config BT_BUF_EVT_RX_SIZE
  default 255

config BT_BUF_ACL_RX_SIZE
  default 255

config BT_BUF_ACL_TX_SIZE
  default 255

config BT_BUF_CMD_TX_SIZE
  default 255

config BT_COMPANY_ID
  default 0x000D

endif # BT

if PM
# Power Management requires increased idle task stack size because of
# stack usage introduced by "pm_state_set"
config IDLE_STACK_SIZE
  default 320
endif # PM

endif # BOARD_LP_EM_CC2340R5
