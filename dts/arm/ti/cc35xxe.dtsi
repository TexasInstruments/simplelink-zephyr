#include <mem.h>
#include <freq.h>
#include <arm/armv8-m.dtsi>

#define INT_SP_UART_0_INT_REQ       16
#define INT_SP_UART_1_INT_REQ       17
#define INT_OSPR_HSM_HOST_0_SEC_IRQ 34
/*
 * Note: Zephyr uses exception numbers, vs the IRQ used by the TI SimpleLink WFF3 SDK
 * which are offset by 16:
 */
#define EXP_UARTA0 (INT_SP_UART_0_INT_REQ - 16)
#define EXP_UARTA1 (INT_SP_UART_1_INT_REQ - 16)
#define EXP_HSM    (INT_OSPR_HSM_HOST_0_SEC_IRQ - 16)

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
		};
	};

	sysclk: system-clock {
		compatible = "fixed-clock";
		clock-frequency = <DT_FREQ_M(160)>;
		#clock-cells = <0>;
	};

	rtc_xtal: clock-rtc-xtal {
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		#clock-cells = <0>;
	};

	uartclk: uart-clock {
		compatible = "fixed-clock";
		clock-frequency = <DT_FREQ_M(80)>;
		#clock-cells = <0>;
	};

	soc {
		/* I-Cache and ITCM size options can be configured independently The user can
		 * decide how to split ITCM and I-Cache in the following configurations:
		 * 1. 32kB I-Cache + 32kB ITCM
		 * 2. 64kB I-Cache + 0kB ITCM
		 */
		icache_ns: icache_ns@0 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x0 DT_SIZE_K(32)>;
			zephyr,memory-region = "ICACHE_NS";
		};

		icache: icache@4000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x4000000 DT_SIZE_K(32)>;
			zephyr,memory-region = "ICACHE";
		};

		itcm_ns: itcm_ns@0 {
			status = "disabled";
			compatible = "zephyr,memory-region", "arm,itcm";
			reg = <0x0 DT_SIZE_K(32)>;
			zephyr,memory-region = "ITCM_NS";
		};

		itcm: itcm@4000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "arm,itcm";
			reg = <0x4000000 DT_SIZE_K(32)>;
			zephyr,memory-region = "ITCM";
		};

		imem_ns: imem_ns@8000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x8000000 DT_SIZE_K(160)>;
			zephyr,memory-region = "IMEM_NS";
		};

		imem: imem@c000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0xc000000 DT_SIZE_K(160)>;
			zephyr,memory-region = "IMEM";
		};

		dtcm_ns: dtcm_ns@20000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "arm,dtcm";
			reg = <0x20000000 DT_SIZE_K(128)>;
			zephyr,memory-region = "DTCM_NS";
		};

		dtcm: dtcm@24000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "arm,dtcm";
			reg = <0x24000000 DT_SIZE_K(128)>;
			zephyr,memory-region = "DTCM";
		};

		dmem_ns: dmem_ns@28000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x28000000 DT_SIZE_K(256)>;
			zephyr,memory-region = "DMEM_NS";
		};

		dmem: dmem@2c000000 {
			status = "disabled";
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x2c000000 DT_SIZE_K(192)>;
			zephyr,memory-region = "DMEM";
		};

		extflash_ns: extflash@10000000 {
			status = "disabled";
			compatible = "zephyr,memory-region";
			reg = <0x10000000 DT_SIZE_M(64)>;
			zephyr,memory-region = "EXTFLASH_NS";
		};

		extflash: extflash@14000000 {
			status = "disabled";
			compatible = "zephyr,memory-region";
			reg = <0x14000000 DT_SIZE_M(64)>;
			zephyr,memory-region = "EXTFLASH";
		};

		uart0: uart@41240000 {
			compatible = "ti,cc35xx-uart";
			current-speed = <115200>;
			reg = <0x41240000 0x1000>;
			interrupts = <EXP_UARTA0 3>;
			clocks = <&uartclk>;
			status = "disabled";
		};

		uart1: uart@41250000 {
			compatible = "ti,cc35xx-uart";
			current-speed = <115200>;
			reg = <0x41250000 0x1000>;
			interrupts = <EXP_UARTA1 3>;
			clocks = <&uartclk>;
			status = "disabled";
		};

		dma: dma@41a00000 {
			compatible = "ti,cc35xx-dma";
			reg = <0x41a00000 0x10000>;
			#dma-cells = <1>;
			status = "disabled";
		};

		hsm: hsm@41b00000 {
			compatible = "ti,cc35xx-hsm";
			interrupts = <EXP_HSM 2>;
			reg = <0x41b00000 0x100000>;
			status = "disabled";
		};

		pinctrl: pin-controller@41140000 {
			compatible = "ti,cc35xx-pinctrl";
			reg = <0x41140000 0x80000>;
		};

		flash0: flash@a0000000 {
			compatible = "ti,cc35xx-nv-flash";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0xa0000000 0x00033000>, <0x0 0x00033000>;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <4>;
		};

		flash1: flash@10000000 {
			compatible = "ti,cc35xx-nv-flash";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x10000000 0x001e7000>, <0x00033000 0x001e7000>;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <4>;
		};

		flash2: flash@a0050000 {
			compatible = "ti,cc35xx-nv-flash";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0xa0050000 0x001ea000>, <0x0021a000 0x001ea000>;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <4>;
		};

		gpios: gpios@41100000 {
			compatible = "ti,cc35xx-gpio-port-bank";
			status = "okay";
			ngpios = <40>;
			interrupts = <17 1>;
			reg = <0x41100000 0x4000>;

			gpio2: gpio2 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <2>;
			};
			gpio3: gpio3 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <3>;
			};
			gpio4: gpio4 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <4>;
			};
			gpio5: gpio5 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <5>;
			};
			gpio6: gpio6 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <6>;
			};
			gpio10: gpio10 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <10>;
			};
			gpio11: gpio11 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <11>;
			};
			gpio12: gpio12 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <12>;
			};
			gpio13: gpio13 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <13>;
			};
			gpio14: gpio14 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <14>;
			};
			gpio15: gpio15 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <15>;
			};
			gpio16: gpio16 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <16>;
			};
			gpio17: gpio17 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <17>;
			};
			gpio18: gpio18 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <18>;
			};
			gpio19: gpio19 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <19>;
			};
			gpio20: gpio20 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <20>;
			};
			gpio21: gpio21 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <21>;
			};
			gpio22: gpio22 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <22>;
			};
			gpio23: gpio23 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <23>;
			};
			gpio24: gpio24 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <24>;
			};
			gpio25: gpio25 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <25>;
			};
			gpio26: gpio26 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <26>;
			};
			gpio27: gpio27 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <27>;
			};
			gpio28: gpio28 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <28>;
			};
			gpio29: gpio29 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <29>;
			};
			gpio30: gpio30 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <30>;
			};
			gpio31: gpio31 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <31>;
			};
			gpio32: gpio32 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <32>;
			};
			gpio33: gpio33 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <33>;
			};
			gpio34: gpio34 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <34>;
			};
			gpio35: gpio35 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <35>;
			};
			gpio36: gpio36 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <36>;
			};
			gpio37: gpio37 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <37>;
			};
			gpio38: gpio38 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <38>;
			};
			gpio39: gpio39 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <39>;
			};
			gpio40: gpio40 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <40>;
			};
			gpio41: gpio41 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <41>;
			};
			gpio42: gpio42 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <42>;
			};
			gpio43: gpio43 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <43>;
			};
			gpio44: gpio44 {
				compatible = "ti,cc35xx-gpio-port-pin";
				status = "disabled";
				gpio-controller;
				#gpio-cells = <2>;
				gpio-index = <44>;
			};
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <3>;
};
